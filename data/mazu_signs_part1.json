{
  "name": "妈祖灵签",
  "total": 60,
  "signs": [
    {"number": 1, "poem": ["日出便見風雲散", "光明清淨照世間", "一向前途通大道", "萬事清吉保平安"]},
    {"number": 2, "poem": ["於今此景正當時", "看看欲吐百花魁", "若能遇得春色到", "一洒清吉脫塵埃"]},
    {"number": 3, "poem": ["勸君把定心莫虛", "天註衣祿自有餘", "和合重重常吉慶", "時來終遇得明珠"]},
    {"number": 4, "poem": ["風恬浪靜可行舟", "恰是中秋月一輪", "凡事不須多憂慮", "福祿自有慶家門"]},
    {"number": 5, "poem": ["只恐前途命有變", "勸君作急可宜先", "且守長江無大事", "命逢太白守身邊"]},
    {"number": 6, "poem": ["風雲致雨落洋洋", "天災時氣必有傷", "命內此事難和合", "更逢一足出外鄉"]},
    {"number": 7, "poem": ["雲開月出正分明", "不須進退問前程", "婚姻皆由天註定", "和合清吉萬事成"]},
    {"number": 8, "poem": ["禾稻看看結成完", "此事必定兩相全", "回到家中寬心坐", "妻兒皷腹樂團圓"]},
    {"number": 9, "poem": ["龍虎相隨在深山", "君爾何須背後看", "不知此去相愛愉", "他日與我卻無干"]},
    {"number": 10, "poem": ["花開結子一半枯", "可惜今年汝虛度", "漸漸日落西山去", "勸君不用向前途"]}
  ]
}
